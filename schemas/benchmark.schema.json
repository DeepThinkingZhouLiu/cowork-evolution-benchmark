{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coworkevobench.local/schemas/benchmark.schema.json",
  "title": "Benchmark 发布清单",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "spec"],
  "properties": {
    "api_version": {
      "const": "cowork-evo-bench/v0.1"
    },
    "kind": {
      "const": "Benchmark"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_source", "evaluator", "partitions", "expected_total"],
      "properties": {
        "task_source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["registry", "revision", "manifest_sha256"],
          "properties": {
            "registry": { "type": "string", "minLength": 1 },
            "revision": { "type": "string", "minLength": 1 },
            "manifest_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "evaluator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["adapter", "version", "result_schema"],
          "properties": {
            "adapter": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "result_schema": { "type": "string", "minLength": 1 }
          }
        },
        "partitions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["feedback", "selection", "final"],
          "properties": {
            "feedback": {
              "$ref": "#/$defs/feedback_partition"
            },
            "selection": {
              "$ref": "#/$defs/selection_partition"
            },
            "final": {
              "$ref": "#/$defs/final_partition"
            }
          }
        },
        "expected_total": { "type": "integer", "minimum": 3 }
      }
    }
  },
  "$defs": {
    "partition_base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visibility", "expected_count", "instance_ids"],
      "properties": {
        "visibility": { "type": "string" },
        "expected_count": { "type": "integer", "minimum": 1 },
        "instance_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "feedback_partition": {
      "allOf": [
        { "$ref": "#/$defs/partition_base" },
        { "properties": { "visibility": { "const": "detailed" } } }
      ]
    },
    "selection_partition": {
      "allOf": [
        { "$ref": "#/$defs/partition_base" },
        { "properties": { "visibility": { "const": "aggregate_only" } } }
      ]
    },
    "final_partition": {
      "allOf": [
        { "$ref": "#/$defs/partition_base" },
        { "properties": { "visibility": { "const": "sealed" } } }
      ]
    }
  }
}
