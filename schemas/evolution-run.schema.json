{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coworkevobench.local/schemas/evolution-run.schema.json",
  "title": "Evolution 实验配置",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "benchmark_id",
    "baseline_harness",
    "evolver",
    "track",
    "model",
    "epochs",
    "candidate_submissions_per_epoch",
    "attempts_per_task",
    "seeds"
  ],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "benchmark_id": { "type": "string", "minLength": 1 },
    "baseline_harness": { "type": "string", "minLength": 1 },
    "evolver": { "type": "string", "minLength": 1 },
    "track": {
      "enum": ["prompt-only", "skill-memory", "full-harness"]
    },
    "model": { "type": "string", "minLength": 1 },
    "epochs": { "type": "integer", "minimum": 1 },
    "candidate_submissions_per_epoch": {
      "type": "integer",
      "minimum": 1
    },
    "attempts_per_task": { "type": "integer", "minimum": 1 },
    "seeds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "integer" }
    },
    "updater_token_budget": { "type": "integer", "minimum": 1 },
    "updater_cost_budget_usd": { "type": "number", "minimum": 0 }
  }
}
