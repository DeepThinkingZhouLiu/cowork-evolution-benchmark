{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coworkevobench.local/schemas/mutation-policy.schema.json",
  "title": "Harness 变异策略",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "track",
    "writable_paths",
    "forbidden_paths",
    "limits"
  ],
  "properties": {
    "api_version": { "const": "cowork-evo-bench/v0.1" },
    "track": {
      "enum": ["prompt-only", "skill-memory", "full-harness"]
    },
    "writable_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "forbidden_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_changed_files", "max_added_bytes"],
      "properties": {
        "max_changed_files": { "type": "integer", "minimum": 1 },
        "max_added_bytes": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
