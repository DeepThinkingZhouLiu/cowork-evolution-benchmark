{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coworkevobench.local/schemas/visual-rubric.schema.json",
  "title": "单题视觉评分标准",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "rubric_version",
    "enabled",
    "reference_mode",
    "candidate_artifacts",
    "criteria"
  ],
  "properties": {
    "task_id": { "type": "string", "minLength": 1 },
    "rubric_version": { "type": "string", "minLength": 1 },
    "enabled": { "type": "boolean" },
    "reference_mode": { "enum": ["reference", "reference_free"] },
    "candidate_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "reference_artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifact" }
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/criterion" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "reference_mode": { "const": "reference" } },
        "required": ["reference_mode"]
      },
      "then": {
        "required": ["reference_artifacts"],
        "properties": { "reference_artifacts": { "minItems": 1 } }
      }
    }
  ],
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["pptx", "pdf"] },
        "label": { "type": "string" }
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion_id",
        "description",
        "weight",
        "score_anchors",
        "evidence_requirement"
      ],
      "properties": {
        "criterion_id": { "type": "string", "pattern": "^V[0-9]{3}$" },
        "description": { "type": "string", "minLength": 1 },
        "weight": { "type": "number", "exclusiveMinimum": 0 },
        "score_anchors": {
          "type": "object",
          "additionalProperties": false,
          "required": ["0", "0.5", "1"],
          "properties": {
            "0": { "type": "string", "minLength": 1 },
            "0.5": { "type": "string", "minLength": 1 },
            "1": { "type": "string", "minLength": 1 }
          }
        },
        "evidence_requirement": { "type": "string", "minLength": 1 }
      }
    }
  }
}
