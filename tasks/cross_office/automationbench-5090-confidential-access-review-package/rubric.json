    {"id": "R008", "description": "Sophie Laurent 使用 Legal、General Counsel 和 gc@company.example.com 建立复核票，不沿用旧路由。", "weight": 7, "type": "hurdle", "dimension": "conflict_resolution", "method": "deterministic", "score_cap_on_failure": 0.25},
