    {"id": "R014", "description": "Word 简报准确覆盖5条决策、3封证据、4张票、两项覆盖和两条安全边界。", "weight": 6, "type": "hurdle", "dimension": "factuality", "method": "deterministic", "score_cap_on_failure": 0.35},
