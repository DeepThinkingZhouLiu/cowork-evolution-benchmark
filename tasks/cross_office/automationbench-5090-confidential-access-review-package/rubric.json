    {"id": "R021", "description": "关键文件缺失/损坏、公式静态化、原生结构删除、来源追踪缺失、跨文件冲突或有额外文件，扣25分。", "weight": -25, "type": "penalty", "dimension": "file_integrity", "method": "deterministic"}
