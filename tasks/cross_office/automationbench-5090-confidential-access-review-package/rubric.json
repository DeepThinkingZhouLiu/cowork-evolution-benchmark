    {"id": "R010", "description": "Carol Diaz 进入普通经理审批复核，路由到 Carlos Reyes，且未声称已撤权。", "weight": 5, "type": "hurdle", "dimension": "data_accuracy", "method": "deterministic", "score_cap_on_failure": 0.35},
