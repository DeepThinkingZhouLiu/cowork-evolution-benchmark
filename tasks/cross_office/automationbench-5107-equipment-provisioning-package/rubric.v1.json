    {"id": "R013", "description": "Jira JSON 恰好含五个 DRAFT_NOT_CREATED 草稿，逐人设备、来源与 created=false 正确，三名排除人员不存在。", "weight": 8, "type": "hurdle", "dimension": "instruction_following", "method": "deterministic", "score_cap_on_failure": 0.2},
