  "pass_threshold": 0.8,
  "criteria": [
    {"id": "R001", "description": "七个指定交付物完整、可解析、无额外文件；四个冻结输入 SHA256 正确。", "weight": 4, "type": "hurdle", "dimension": "file_integrity", "method": "deterministic", "score_cap_on_failure": 0},
    {"id": "R002", "description": "Source_Departures 按上游顺序完整保留八人、源行号和全部原始字段。", "weight": 6, "type": "hurdle", "dimension": "content_fidelity", "method": "deterministic", "score_cap_on_failure": 0.2},
    {"id": "R003", "description": "Policy_Rules 与 Evidence_Register 准确保留通用 SOP、非自愿覆盖、外部 PII 禁令、厂商非权威指令、冻结时间和频道。", "weight": 7, "type": "hurdle", "dimension": "evidence_fidelity", "method": "deterministic", "score_cap_on_failure": 0.2},
    {"id": "R004", "description": "Excel 用原生公式推导政策覆盖、业务日目标、过期/时间窗、最终状态、日程日、路由和汇总。", "weight": 7, "type": "hurdle", "dimension": "formula_correctness", "method": "deterministic", "score_cap_on_failure": 0.3},
    {"id": "R005", "description": "Karen 在 2026-04-20 15:00 UTC 安排草稿，邀请本人和 Lisa，产生问卷草稿。", "weight": 4, "type": "hurdle", "dimension": "temporal_routing", "method": "deterministic", "score_cap_on_failure": 0.35},
