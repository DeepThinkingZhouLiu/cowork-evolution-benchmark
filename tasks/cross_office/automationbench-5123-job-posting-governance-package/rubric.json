    {"id":"R003","description":"两封源邮件、七条政策与20条证据逐字段准确，含历史格式、>90、冷联系禁令、时间与频道。","weight":8,"type":"positive","dimension":"traceability","method":"deterministic"},
    {"id":"R004","description":"Excel 恰好422个任务专属公式，逐行派生28列决策、四个队列/控制表与20项摘要。","weight":12,"type":"positive","dimension":"formula_correctness","method":"deterministic"},
    {"id":"R005","description":"八岗五类决策、4个直接重发、1个VP审批、3个零动作、六项通信与90天严格边界逐原子单元正确。","weight":12,"type":"positive","dimension":"data_accuracy","method":"deterministic"},
    {"id":"R006","description":"六封MBOX按源序排列，逐封核验路由、头字段、历史格式、审批/重同意边界和未发送状态。","weight":8,"type":"positive","dimension":"instruction_following","method":"deterministic"},
