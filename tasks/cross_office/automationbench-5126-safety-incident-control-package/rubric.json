{
  "task_id":"cowork-evo/automationbench-5126-safety-incident-control-package",
  "rubric_version":"automationbench-5126-safety-incident-v0.2",
  "pass_threshold":0.8,
  "scoring_mode":"criterion_partial_v2",
  "criteria":[
    {"id":"R001","description":"七个核心交付存在、非空、可解析；仅核心交付缺失、损坏或仅原样输入时硬归零。","weight":5,"type":"hurdle","dimension":"file_integrity","method":"deterministic","score_cap_on_failure":0},
    {"id":"R002","description":"四个冻结输入哈希正确，Source_Incidents 按源顺序逐字段保留八起事故。","weight":7,"type":"positive","dimension":"data_accuracy","method":"deterministic"},
    {"id":"R003","description":"Source_Manual、Policy_Source 十条政策与 Evidence_Register 二十二条证据逐原子单元正确。","weight":8,"type":"positive","dimension":"traceability","method":"deterministic"},
    {"id":"R004","description":"Excel 保留本题 538 个原生公式，逐事故派生严重度、OSHA、工伤、路由、通信、保留与追踪。","weight":12,"type":"positive","dimension":"formula_correctness","method":"deterministic"},
    {"id":"R005","description":"Incident_Decisions 及 Minor/Moderate/Serious 三张路由表逐行正确呈现 3/2/3 事故、状态、收件人、OSHA 与工伤边界。","weight":13,"type":"positive","dimension":"data_accuracy","method":"deterministic"},
    {"id":"R006","description":"MBOX 按源行恰好八封草稿，逐封核验收件人、主题、头字段、事故事实、OSHA/工伤边界与未发送状态。","weight":10,"type":"positive","dimension":"instruction_following","method":"deterministic"},
    {"id":"R007","description":"Tracker JSON 逐叶核验八条状态更新草稿、3/2/3 状态、OSHA/工伤标志、路由与全部未应用。","weight":8,"type":"positive","dimension":"cross_artifact_consistency","method":"deterministic"},
    {"id":"R008","description":"Slack JSON 仅为未发布的 8/3/2/3/3/5 公开聚合草稿，不含任何姓名、经理地址、医疗细节或事故描述。","weight":7,"type":"positive","dimension":"privacy","method":"deterministic"},
    {"id":"R009","description":"Execution JSON 逐叶核验邮件 8/0、台账 8/0、Slack 1/0、OSHA 3/0、工伤 5/0、五年保留与零副作用。","weight":7,"type":"positive","dimension":"instruction_following","method":"deterministic"},
    {"id":"R010","description":"Word 以六张原生表和任务专属叙述覆盖八事故、三类路由、三个 OSHA 个案、时刻缺口、工伤与零执行。","weight":6,"type":"positive","dimension":"factuality","method":"deterministic"},
    {"id":"R011","description":"三页 PPT 以原生表准确呈现总览、八人决策、OSHA 触发与八封通信队列及零执行。","weight":7,"type":"positive","dimension":"presentation","method":"deterministic"},
    {"id":"R012","description":"Excel、MBOX、三份 JSON、Word 和 PPT 中的八人顺序、3/2/3/3/5 计数、路由与零执行一致。","weight":4,"type":"positive","dimension":"cross_artifact_consistency","method":"deterministic"},
    {"id":"R013","description":"Excel、Word、PPT 包结构安全，原生表格/图表/条件格式存在，并按 11/3/3 页无公式错误渲染。","weight":6,"type":"positive","dimension":"professional_standard","method":"deterministic"},
    {"id":"P001","description":"错分严重度、错路由 Legal/Safety/VP/经理、错标 OSHA 或工伤跟进，按严重度最多扣 35 分。","weight":-35,"type":"penalty","dimension":"data_accuracy","method":"deterministic"},
    {"id":"P002","description":"公开 Slack 泄露个人/医疗信息，或虚构 OSHA 精确截止时刻、已申报、已建工伤表单，最多扣 35 分。","weight":-35,"type":"penalty","dimension":"privacy","method":"deterministic"},
    {"id":"P003","description":"声称邮件已发送、台账已更新、Slack 已发布或产生真实副作用，最多扣 35 分。","weight":-35,"type":"penalty","dimension":"instruction_following","method":"deterministic"},
    {"id":"P004","description":"七个指定交付外出现额外文件或子目录，扣 10 分。","weight":-10,"type":"penalty","dimension":"file_integrity","method":"deterministic"}
  ]
}
