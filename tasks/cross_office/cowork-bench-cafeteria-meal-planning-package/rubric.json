    {"id":"R010","description":"ICS 的 5 个事件逐项检查日期、08:00–09:30、Europe/Moscow、Lunch 菜名、实际采购店和未报价原料。","weight":7,"type":"positive","dimension":"data_accuracy","method":"deterministic","method_params":{"events":5,"atomic_fields":true}},
    {"id":"R011","description":"JSON、Excel、Word 与 ICS 的商品、菜品、菜单行及五天 Lunch 按跨文件原子关系计分。","weight":6,"type":"positive","dimension":"cross_artifact_consistency","method":"deterministic","method_params":{"artifacts":4,"atomic_relations":true}},
    {"id":"R012","description":"Excel 每表的原生表、冻结首行、表头样式和列宽，以及 Word 原生表和标题层级逐项计分。","weight":4,"type":"positive","dimension":"professional_standard","method":"deterministic","method_params":{"native_editable":true}},
    {"id":"R013","description":"LibreOffice 实际重算并渲染三页 Excel 与至少两页 Word，检查核心文字可见。","weight":3,"type":"positive","dimension":"professional_standard","method":"deterministic","method_params":{"renderer":"libreoffice"}},
    {"id":"R014","description":"JSON 与 Word 分别披露报价篮子、未报价不估值及蛋白质因无营养数据无法验证。","weight":4,"type":"positive","dimension":"factuality","method":"deterministic","method_params":{"boundary_units":5}},
