  "pass_threshold": 0.8,
  "scoring_mode": "criterion_partial_v2",
  "criteria": [
    {"id": "R001", "description": "三个核心交付存在、非空、可解析且三份冻结输入哈希正确；只有核心完整性失败或原样输入冒充交付时硬归零。", "weight": 5, "type": "hurdle", "dimension": "file_integrity", "method": "deterministic", "method_params": {"required_files": 3}, "score_cap_on_failure": 0},
    {"id": "R002", "description": "Holdings 的 16 个表头、5 个代码以及公司、行业、数量、市值、币种和交易所逐字段计分。", "weight": 8, "type": "positive", "dimension": "data_accuracy", "method": "deterministic", "method_params": {"holdings": 5, "issuer_fields_per_holding": 7}},
    {"id": "R003", "description": "5 个代码的基准日期/收盘价与当前日期/收盘价按 20 个冻结行情边界单元计分。", "weight": 8, "type": "positive", "dimension": "factuality", "method": "deterministic", "method_params": {"holdings": 5, "boundary_fields": 4}},
    {"id": "R004", "description": "Current_Value、Return_30d_Pct 与 Weight_Pct 的 15 个可复制公式分别检查行引用、运算和重算真值。", "weight": 12, "type": "positive", "dimension": "formula_correctness", "method": "deterministic", "method_params": {"formula_cells": 15}},
    {"id": "R005", "description": "5 行 Large Cap 与 Policy_Status 公式逐行检查严格阈值、政策字段引用和重算值。", "weight": 7, "type": "positive", "dimension": "instruction_following", "method": "deterministic", "method_params": {"formula_cells": 10}},
    {"id": "R006", "description": "Summary 的 10 项标签、原生公式与重算值逐项计分，包括 Energy 合并、最佳/最差、最大行业和 5/5 合规。", "weight": 10, "type": "positive", "dimension": "data_accuracy", "method": "deterministic", "method_params": {"metrics": 10}},
    {"id": "R007", "description": "Source_Prices 的 8 个表头与 115 行×8 个冻结来源字段逐单元格计分。", "weight": 10, "type": "positive", "dimension": "traceability", "method": "deterministic", "method_params": {"source_rows": 115, "fields_per_row": 8}},
    {"id": "R008", "description": "Word 标题/章节、原生持仓表及 5 个持仓的代码、公司、行业、数量、价格、市值、收益率和权重逐项计分。", "weight": 9, "type": "positive", "dimension": "content_quality", "method": "deterministic", "method_params": {"holdings": 5}},
    {"id": "R009", "description": "Word 的总市值、最佳/最差、Energy 暴露、5/5 合规及无虚构政策限额逐项计分。", "weight": 7, "type": "positive", "dimension": "factuality", "method": "deterministic"},
    {"id": "R010", "description": "Recommendations 至少两条、分别锚定弱表现/行业暴露/强表现，并明确冻结窗口不能证明因果或自动买卖。", "weight": 5, "type": "positive", "dimension": "content_quality", "method": "deterministic", "method_params": {"minimum_recommendations": 2}},
    {"id": "R011", "description": "EML 发件人、收件人、主题、估值日、总市值、最佳/最差代码及收益率逐字段计分。", "weight": 6, "type": "positive", "dimension": "factuality", "method": "deterministic"},
    {"id": "R012", "description": "EML 恰好嵌入 Excel 与 Word，逐附件检查名称、MIME 类型和与输出文件字节一致。", "weight": 7, "type": "positive", "dimension": "cross_artifact_consistency", "method": "deterministic", "method_params": {"attachments": 2}},
    {"id": "R013", "description": "Excel 原生表/图表/筛选/冻结/条件格式、Word 原生表/标题样式、Office 包安全性及 LibreOffice 可打开性逐项计分。", "weight": 6, "type": "positive", "dimension": "professional_standard", "method": "deterministic", "method_params": {"renderer": "libreoffice"}},
    {"id": "R014", "description": "持仓代码集合缺失、重复、替换或增加时按受影响比例触发身份完整性处罚。", "weight": -30, "type": "penalty", "dimension": "identity_integrity", "method": "deterministic", "method_params": {"continuous_severity": true}},
    {"id": "R015", "description": "Word/邮件与 Excel 在总市值、最佳/最差或行业结论上出现明确冲突时按载体数处罚，普通局部遗漏不重复处罚。", "weight": -25, "type": "penalty", "dimension": "cross_artifact_consistency", "method": "deterministic", "method_params": {"continuous_severity": true}},
    {"id": "R016", "description": "邮件错投、主题严重错误、附件缺失或陈旧错配时按严重度处罚。", "weight": -30, "type": "penalty", "dimension": "file_integrity", "method": "deterministic", "method_params": {"continuous_severity": true}},
    {"id": "R017", "description": "Holdings/Summary 公式大面积静态化、宏、危险外链、绝对路径、Golden/Judge 泄漏或额外调试文件按严重度处罚。", "weight": -25, "type": "penalty", "dimension": "file_integrity", "method": "deterministic", "method_params": {"continuous_severity": true}},
    {"id": "R018", "description": "回流上游错误美股/USD、虚构政策阈值、无证据市场因果或自动买卖结论时按严重度处罚。", "weight": -25, "type": "penalty", "dimension": "factuality", "method": "deterministic", "method_params": {"continuous_severity": true}}
  ]
}
