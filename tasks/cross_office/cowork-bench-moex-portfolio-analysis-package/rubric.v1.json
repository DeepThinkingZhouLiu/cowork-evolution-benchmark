{
  "task_id": "cowork-evo/cowork-bench-moex-portfolio-analysis-package",
  "rubric_version": "cowork-bench-moex-portfolio-analysis-v0.1",
  "pass_threshold": 0.8,
  "criteria": [
    {"id": "R001", "description": "三个指定交付物完整、可打开且输出目录没有额外文件；三份冻结输入 SHA256 与清单一致。", "weight": 5, "type": "hurdle", "dimension": "file_integrity", "method": "deterministic", "score_cap_on_failure": 0},
    {"id": "R002", "description": "Holdings 保留输入的 5 个代码、公司和数量，行业、市值、币种和交易所与快照一致。", "weight": 7, "type": "hurdle", "dimension": "data_accuracy", "method": "deterministic", "score_cap_on_failure": 0.3},
    {"id": "R003", "description": "对每个代码正确选取 2026-04-24 基准收盘价和 2026-05-26 最新收盘价。", "weight": 8, "type": "hurdle", "dimension": "factuality", "method": "deterministic", "score_cap_on_failure": 0.35},
    {"id": "R004", "description": "Current_Value、Return_30d_Pct 和 Weight_Pct 使用可复制原生公式，全部 5 行与 Judge 从输入独立重算的精确值一致。", "weight": 12, "type": "hurdle", "dimension": "data_accuracy", "method": "deterministic", "score_cap_on_failure": 0.35},
    {"id": "R005", "description": "Market_Cap_Category 与 Policy_Status 使用原生公式，正确将 5 个持仓标为 Large Cap 且符合政策，不编造政策上限。", "weight": 7, "type": "hurdle", "dimension": "instruction_following", "method": "deterministic", "score_cap_on_failure": 0.5},
    {"id": "R006", "description": "Summary 的总市值、最佳/最差代码、4 个行业市值、最大行业及其权重和合规数均为原生公式且真值正确。", "weight": 9, "type": "hurdle", "dimension": "data_accuracy", "method": "deterministic", "score_cap_on_failure": 0.45},
    {"id": "R007", "description": "Source_Prices 完整保留 115 行冻结市场快照，日期、收盘价和发行人字段可追溯。", "weight": 8, "type": "hurdle", "dimension": "traceability", "method": "deterministic", "score_cap_on_failure": 0.5},
    {"id": "R008", "description": "Word 使用标题样式和原生表格准确呈现全部 5 个持仓的数值与收益率。", "weight": 9, "type": "hurdle", "dimension": "content_quality", "method": "deterministic", "score_cap_on_failure": 0.5},
    {"id": "R009", "description": "Word 的 Performance Analysis 与 Policy Review 正确给出总市值、MTSS.ME 最佳、SBER.ME 最差、Energy 最大暴露和 5/5 合规。", "weight": 7, "type": "hurdle", "dimension": "factuality", "method": "deterministic", "score_cap_on_failure": 0.55},
    {"id": "R010", "description": "Recommendations 至少包含两条可执行且有数据依据的后续建议，不将同期波动写成无来源因果。", "weight": 5, "type": "hurdle", "dimension": "content_quality", "method": "deterministic", "score_cap_on_failure": 0.6},
    {"id": "R011", "description": "EML 的发件人、收件人和主题精确，正文与 Excel/Word 一致地包含总市值、最佳/最差代码和收益率。", "weight": 6, "type": "hurdle", "dimension": "factuality", "method": "deterministic", "score_cap_on_failure": 0.5},
    {"id": "R012", "description": "EML 真正嵌入本次交付的 Excel 和 Word，附件名、MIME 类型和字节 SHA256 与输出文件一致。", "weight": 8, "type": "hurdle", "dimension": "cross_artifact_consistency", "method": "deterministic", "score_cap_on_failure": 0.4},
    {"id": "R013", "description": "Excel 与 Word 可由 LibreOffice 无界面打开并渲染，原生表格、公式、筛选、冻结和排版可继续编辑且无明显截断。", "weight": 9, "type": "positive", "dimension": "professional_standard", "method": "deterministic"},
    {"id": "R014", "description": "任一持仓、行情边界、市值、收益率、权重或汇总与输入重算真值冲突，扣 30 分。", "weight": -30, "type": "penalty", "dimension": "data_accuracy", "method": "deterministic"},
    {"id": "R015", "description": "Excel、Word 与邮件在总市值、最佳/最差、行业或政策结论上相互冲突，扣 25 分。", "weight": -25, "type": "penalty", "dimension": "cross_artifact_consistency", "method": "deterministic"},
    {"id": "R016", "description": "邮件错投、主题错误、附件缺失、附件过期或附件字节与实际交付不一致，扣 30 分。", "weight": -30, "type": "penalty", "dimension": "file_integrity", "method": "deterministic"},
    {"id": "R017", "description": "关键文件缺失、损坏、公式静态化、表格截图化、存在危险外链、绝对路径或额外调试文件，扣 25 分。", "weight": -25, "type": "penalty", "dimension": "file_integrity", "method": "deterministic"},
    {"id": "R018", "description": "出现上游错误 Golden 中的美股代码、USD 数据，或编造政策限额、市场原因与买卖结论，扣 15 分。", "weight": -15, "type": "penalty", "dimension": "factuality", "method": "deterministic"}
  ]
}
