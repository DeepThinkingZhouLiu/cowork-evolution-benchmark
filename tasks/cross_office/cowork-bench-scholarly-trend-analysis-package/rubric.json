    {
      "id": "R005",
      "description": "交付 JSON 的四项 metrics 由 data_analysis 正确计算，且至少两条 recommendations 的 Area 均真实存在。",
      "weight": 6,
      "type": "hurdle",
      "dimension": "data_accuracy",
      "method": "deterministic",
      "method_params": {"metric_rounding": "half_up_integer", "minimum_recommendations": 2},
      "score_cap_on_failure": 0.5
    },
    {
      "id": "R006",
      "description": "Excel 恰好包含 Data_Analysis、Metrics、Recommendations 三张表，Data_Analysis 的列、行、排序和数值与输入重算真值一致。",
      "weight": 8,
      "type": "hurdle",
      "dimension": "data_accuracy",
      "method": "deterministic",
      "method_params": {"sheet_names": ["Data_Analysis", "Metrics", "Recommendations"], "rows": 4},
      "score_cap_on_failure": 0.35
    },
    {
      "id": "R007",
      "description": "Excel Metrics 的四个 Value 使用可审计公式从 Data_Analysis 推导，LibreOffice 重算后与输入真值一致。",
      "weight": 7,
      "type": "hurdle",
      "dimension": "factuality",
      "method": "deterministic",
      "method_params": {"required_formula_cells": ["Metrics!B2:B5"], "recalculate": "libreoffice"},
      "score_cap_on_failure": 0.6
    },
    {
      "id": "R008",
      "description": "Excel Recommendations 与 JSON recommendations 的顺序、Priority、Action 和 Area 完全一致。",
