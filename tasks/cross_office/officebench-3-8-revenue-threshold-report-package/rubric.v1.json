{
  "task_id": "cowork-evo/officebench-3-8-revenue-threshold-report-package",
  "rubric_version": "officebench-3-8-revenue-threshold-report-v0.1",
  "pass_threshold": 0.8,
  "criteria": [
    {"id": "R001", "description": "两个指定交付物完整、可打开且无额外文件；冻结输入 SHA256 与清单一致。", "weight": 5, "type": "hurdle", "dimension": "file_integrity", "method": "deterministic", "score_cap_on_failure": 0},
    {"id": "R002", "description": "Source_Data 与 Threshold_Audit 完整保留输入的 20 个年份和收入，不新增、删改或调序。", "weight": 8, "type": "hurdle", "dimension": "content_fidelity", "method": "deterministic", "score_cap_on_failure": 0.3},
    {"id": "R003", "description": "Retained_Years 恰好包含收入大于或等于 200 万美元的 17 个年份，边界规则与顺序正确。", "weight": 10, "type": "hurdle", "dimension": "data_accuracy", "method": "deterministic", "score_cap_on_failure": 0.35},
    {"id": "R004", "description": "Removed_Years 恰好包含 2006、2009、2017 及准确收入和门槛差额。", "weight": 8, "type": "hurdle", "dimension": "data_accuracy", "method": "deterministic", "score_cap_on_failure": 0.4},
    {"id": "R005", "description": "Threshold_Audit、Retained_Years 与 Removed_Years 的状态、差额、排名和变化字段使用可复制原生公式且重算正确。", "weight": 10, "type": "hurdle", "dimension": "formula_correctness", "method": "deterministic", "score_cap_on_failure": 0.4},
    {"id": "R006", "description": "Summary 的 12 项指标均为原生公式，并与 Judge 从输入独立重算的真值一致。", "weight": 12, "type": "hurdle", "dimension": "numeric_accuracy", "method": "deterministic", "score_cap_on_failure": 0.45},
    {"id": "R007", "description": "Excel 包含原生表格、筛选、冻结窗格、条件格式和可编辑趋势图，结构适合继续分析。", "weight": 6, "type": "positive", "dimension": "professional_standard", "method": "deterministic"},
    {"id": "R008", "description": "Word 标题、五个规定章节和原生表格齐全，并清楚说明大于等于门槛保留、低于门槛移除。", "weight": 7, "type": "hurdle", "dimension": "instruction_following", "method": "deterministic", "score_cap_on_failure": 0.5},
    {"id": "R009", "description": "Word 准确呈现 17 个保留、3 个移除、85% 保留率，以及三个移除年份、收入和差额。", "weight": 9, "type": "hurdle", "dimension": "factuality", "method": "deterministic", "score_cap_on_failure": 0.5},
    {"id": "R010", "description": "Word 的总额、平均值、最高/最低保留年份和首尾变化正确，且明确限制为输入数据描述。", "weight": 7, "type": "hurdle", "dimension": "content_quality", "method": "deterministic", "score_cap_on_failure": 0.55},
    {"id": "R011", "description": "Excel 与 Word 的年份、金额、比例、筛选结论和趋势结论完全一致。", "weight": 10, "type": "hurdle", "dimension": "cross_artifact_consistency", "method": "deterministic", "score_cap_on_failure": 0.4},
    {"id": "R012", "description": "Excel 与 Word 可由 LibreOffice 无界面渲染，版面清楚、无公式错误或明显截断。", "weight": 8, "type": "positive", "dimension": "professional_readiness", "method": "deterministic"},
    {"id": "R013", "description": "任一年份、收入、门槛分类、差额、汇总或趋势真值错误，扣 30 分。", "weight": -30, "type": "penalty", "dimension": "data_accuracy", "method": "deterministic"},
    {"id": "R014", "description": "Excel 与 Word 对同一事实或筛选结论相互冲突，扣 25 分。", "weight": -25, "type": "penalty", "dimension": "cross_artifact_consistency", "method": "deterministic"},
    {"id": "R015", "description": "关键文件缺失、损坏、公式静态化、表格截图化、存在危险外链、绝对路径或额外调试文件，扣 25 分。", "weight": -25, "type": "penalty", "dimension": "file_integrity", "method": "deterministic"},
    {"id": "R016", "description": "编造通胀、市场、产品、管理层、利润或预测等输入不支持的原因与结论，扣 15 分。", "weight": -15, "type": "penalty", "dimension": "factuality", "method": "deterministic"}
  ]
}
