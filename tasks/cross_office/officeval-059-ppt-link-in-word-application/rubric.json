  "scoring_policy":{"default_version":"v2","legacy_version":"v1","hard_zero":"仅当核心 DOCX/PPTX 缺失、为空、损坏/不可解析，或将未修改的输入 Word 改名交回时记 0 分。","partial_credit":"其他错误按 PPT 保真、目标单元格定位、超链接关系、样式、原 Word 保留、渲染和可编辑表格给连续部分分。"},
  "criteria":[
