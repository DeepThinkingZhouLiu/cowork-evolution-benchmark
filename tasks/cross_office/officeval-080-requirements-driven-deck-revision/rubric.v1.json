  "criteria": [
    {
      "id": "R001",
      "description": "四个指定名称的交付文件齐全，PPTX 与 XLSX 可打开，PPTX 严格为 18 页并保留原生可编辑文本和图片对象。",
      "weight": 5,
      "type": "hurdle",
      "dimension": "file_integrity",
      "method": "deterministic",
      "method_params": {"required_files": 4, "slide_count": 18, "native_editable": true},
      "score_cap_on_failure": 0
    },
    {
      "id": "R002",
      "description": "处理器真实读取 Word、内嵌图片和源 PPTX；原输入 replay 与“12cm→13cm、16页→17页”内容变异 replay 均正确。",
      "weight": 6,
      "type": "hurdle",
      "dimension": "factuality",
      "method": "deterministic",
      "method_params": {"canonical_replay": true, "metamorphic_replay": "12cm_to_13cm_and_slide16_to_slide17"},
      "score_cap_on_failure": 0
