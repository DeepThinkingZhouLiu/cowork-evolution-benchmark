      "weight": 4,
      "type": "positive",
      "dimension": "instruction_following",
      "method": "deterministic",
      "method_params": {"slides": [1, 2, 3], "font_delta_points": [2, 3]}
    },
    {
      "id": "R004",
      "description": "第3页右侧使用要求.docx 的真实学生图片，宽度从审阅意见动态读取，高度从 Word 中显示比例重算，且不遮挡文字。",
      "weight": 4,
      "type": "positive",
      "dimension": "factuality",
      "method": "deterministic",
      "method_params": {"slide": 3, "embedded_asset": "image1.png", "dynamic_dimensions": true}
    },
    {
      "id": "R005",
      "description": "第4页保留源稿真实探险图片并改成左图右文；第5页两张新增图片均逐字节来自要求.docx，显示比例与 Word 一致且不遮字。",
      "weight": 5,
      "type": "positive",
      "dimension": "presentation",
      "method": "deterministic",
      "method_params": {"slides": [4, 5], "embedded_assets": ["image2.png", "image3.png"]}
    },
    {
      "id": "R006",
