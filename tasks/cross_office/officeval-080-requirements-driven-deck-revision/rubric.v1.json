      "weight": 3,
      "type": "positive",
      "dimension": "content_quality",
      "method": "deterministic",
      "method_params": {"slide": 6, "answer_groups": 4, "lines_per_group": 2}
    },
    {
      "id": "R007",
      "description": "第8、9页每组小标题和对应正文都有独立可触发进入动画，同组一致、四组效果互异。",
      "weight": 6,
      "type": "positive",
      "dimension": "presentation",
      "method": "deterministic",
      "method_params": {"slides": [8, 9], "animation_groups": 4}
    },
    {
      "id": "R008",
      "description": "第10页准确替换为指定标题，标题下方曲线图逐字节来自要求.docx，尺寸由真实审阅意见和图片显示比例确定。",
      "weight": 5,
      "type": "positive",
      "dimension": "factuality",
      "method": "deterministic",
      "method_params": {"slide": 10, "embedded_asset": "image4.png", "dynamic_dimensions": true}
    },
    {
      "id": "R009",
