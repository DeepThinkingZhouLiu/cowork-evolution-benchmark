    {
      "id": "R012",
      "description": "未改页面标题保持，文字不越界且不存在三处以上显著文字重叠；PPTX 和 XLSX 均可由 LibreOffice 实际渲染。",
      "weight": 5,
      "type": "positive",
      "dimension": "professional_standard",
      "method": "deterministic",
      "method_params": {"preserve_untouched_titles": true, "max_significant_text_overlaps": 2, "render_with_libreoffice": true}
