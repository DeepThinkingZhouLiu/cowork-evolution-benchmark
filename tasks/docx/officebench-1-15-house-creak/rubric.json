  "pass_threshold": 0.8,
  "criteria": [
    {"id": "R001", "description": "指定 DOCX 存在，可作为原生 OOXML 打开、编辑和渲染。", "weight": 12, "type": "hurdle", "dimension": "file_integrity", "score_cap_on_failure": 0.0},
    {"id": "R002", "description": "原故事 47 个段落的文字、顺序、核心格式、页面几何和页码完整保护。", "weight": 20, "type": "hurdle", "dimension": "preservation", "score_cap_on_failure": 0.35},
    {"id": "R003", "description": "附录以下一页分节符开始，具有正确标题层级、可更新的 TOC 字段和独立页眉。", "weight": 9, "type": "positive", "dimension": "document_structure"},
    {"id": "R004", "description": "120–180 词 Synopsis 准确覆盖六段核心因果链，不引入无来源故事事实。", "weight": 10, "type": "positive", "dimension": "analysis"},
    {"id": "R005", "description": "Incident Chronology 是按时序排列的 6 行原生 Word 表格，每行的证据、风险、后果与输入一致。", "weight": 14, "type": "hurdle", "dimension": "evidence_traceability", "score_cap_on_failure": 0.72},
    {"id": "R006", "description": "Character Decision Matrix 以 5 行原生 Word 表格对齐角色、行为、事件影响与编辑解读。", "weight": 11, "type": "hurdle", "dimension": "evidence_synthesis", "score_cap_on_failure": 0.72},
    {"id": "R007", "description": "三条 Word 批注分别精确锚定电气预警、结构失效和风险确认原文，批注内容与编辑目的一致。", "weight": 10, "type": "hurdle", "dimension": "native_word_objects", "score_cap_on_failure": 0.72},
    {"id": "R008", "description": "Chronology 的 6 个 Source link 为有效内部链接，指向原文中存在的独立书签。", "weight": 6, "type": "positive", "dimension": "navigation"},
    {"id": "R009", "description": "无宏、OLE、外部链接或整页截图替代；两张表具有网格、重复表头和禁止数据行跨页的原生结构。", "weight": 4, "type": "positive", "dimension": "editability_safety"},
    {"id": "R010", "description": "LibreOffice 全文渲染可读，无空白页、明显裁切或关键结构丢失。", "weight": 4, "type": "positive", "dimension": "professional_readiness"}
  ]
