    {"id": "R007", "description": "明确一页证据边界，无臆造 DOI、会议/期刊、通讯作者、baseline 或统计细节。", "weight": 8, "type": "hurdle", "dimension": "non_fabrication", "score_cap_on_failure": 0.78},
    {"id": "R008", "description": "12 个控制 ID 与证据段书签内链一一对应。", "weight": 5, "type": "positive", "dimension": "navigation"},
