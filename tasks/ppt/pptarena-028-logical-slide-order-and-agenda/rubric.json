    {"id": "R005", "description": "除议程顺序和页码外，六页的标题、正文、日期、来源、几何、裁剪、z-order 和备注保持。", "weight": 14, "type": "hurdle", "dimension": "preservation", "method": "deterministic", "score_cap_on_failure": 0},
