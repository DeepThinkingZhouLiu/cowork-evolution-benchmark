    {"id": "R001", "description": "指定 PPTX 可打开、ZIP 包无损坏，页面尺寸不变且严格保持 6 页。", "weight": 6, "type": "hurdle", "dimension": "file_integrity", "method": "deterministic", "score_cap_on_failure": 0},
