    {"id": "R006", "description": "三条原图注位于对应图片下方、宽度匹配且文字居中，图文组水平分布无重叠越界。", "weight": 12, "type": "hurdle", "dimension": "professional_readiness", "method": "deterministic", "score_cap_on_failure": 0},
    {"id": "R007", "description": "封面对象与三张媒体保持，页面未压平、未加入整页截图或答案标记。", "weight": 10, "type": "hurdle", "dimension": "preservation", "method": "deterministic", "score_cap_on_failure": 0},
    {"id": "R008", "description": "LibreOffice 可渲染 3 页；文稿无宏、坏关系和多余输出。", "weight": 6, "type": "positive", "dimension": "delivery_hygiene", "method": "deterministic"},
    {"id": "R009", "description": "若页数错误、分数遗漏/错队、列表或图表残留、图片替换/错位、图注未居中或压平，扣 20 分。", "weight": -20, "type": "penalty", "dimension": "instruction_following", "method": "deterministic"}
