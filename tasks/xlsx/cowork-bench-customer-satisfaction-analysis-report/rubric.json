{
  "task_id": "cowork-evo/cowork-bench-customer-satisfaction-analysis-report",
  "rubric_version": "cowork-bench-customer-satisfaction-analysis-report-v0.1",
  "pass_threshold": 0.8,
  "criteria": [
    {
      "id": "R001",
      "description": "四个指定交付物均存在、可打开且工作表名正确。",
      "weight": 5,
      "type": "hurdle",
      "dimension": "file_integrity",
      "method": "deterministic",
      "method_params": {"required_files": 4, "sheet_names": ["Satisfaction Analysis", "Action Plans"]},
      "score_cap_on_failure": 0
    },
    {
      "id": "R002",
      "description": "Summary Metrics 的四项核心值与问卷和客服 CSV 重算真值一致。",
      "weight": 8,
      "type": "hurdle",
      "dimension": "data_accuracy",
      "method": "deterministic",
      "method_params": {"truth_source": "survey_and_support_inputs", "metrics": 4, "tolerance": 0.011},
      "score_cap_on_failure": 0.4
    },
    {
      "id": "R003",
      "description": "Dimension Ratings 的五个平均值与问卷 Responses 重算真值一致。",
      "weight": 6,
      "type": "hurdle",
      "dimension": "data_accuracy",
      "method": "deterministic",
      "method_params": {"dimensions": 5, "tolerance": 0.011},
      "score_cap_on_failure": 0.55
    },
    {
      "id": "R004",
      "description": "Segment Analysis 完整包含 Enterprise、Mid-Market 和 SMB，每个分群的样本数、满意度、NPS 和首次解决率均正确。",
      "weight": 8,
      "type": "hurdle",
      "dimension": "data_accuracy",
      "method": "deterministic",
      "method_params": {"segments": 3, "truth_source": "survey_responses"},
      "score_cap_on_failure": 0.45
    },
    {
      "id": "R005",
      "description": "Action Plans 表头完整，至少三条行动的名称、负责角色、指标、基线、目标、时间和状态均非空。",
      "weight": 4,
      "type": "hurdle",
      "dimension": "structure",
      "method": "deterministic",
      "method_params": {"headers": 7, "minimum_rows": 3},
      "score_cap_on_failure": 0.7
    },
    {
      "id": "R006",
      "description": "行动计划覆盖 FCR、平均解决时长和 SMB 满意度；三项基线与输入一致，目标方向正确，Owner 为角色而非虚构人名。",
      "weight": 6,
      "type": "hurdle",
      "dimension": "factuality",
      "method": "deterministic",
      "method_params": {"required_action_families": ["fcr", "resolution_time", "smb_satisfaction"]},
      "score_cap_on_failure": 0.65
    },
    {
      "id": "R007",
      "description": "详细报告为俄文可编辑文档，包含数据与方法、核心指标、维度、分群、行动与限制等清晰结构。",
      "weight": 4,
      "type": "positive",
      "dimension": "content_quality",
      "method": "deterministic",
      "method_params": {"language": "ru", "minimum_characters": 1800, "required_sections": 6}
    },
    {
      "id": "R008",
      "description": "详细报告准确写出真实样本量、四项核心指标、五个维度和三个分群结果。",
      "weight": 7,
      "type": "hurdle",
      "dimension": "factuality",
      "method": "deterministic",
      "method_params": {"survey_n": 50, "support_n": 20, "cross_artifact": true},
      "score_cap_on_failure": 0.5
    },
    {
      "id": "R009",
      "description": "高管摘要为简洁俄文文档，包含真实样本量、四项核心指标、SMB 最低结论和三个优先行动。",
      "weight": 6,
      "type": "hurdle",
      "dimension": "content_quality",
      "method": "deterministic",
      "method_params": {"minimum_characters": 650, "maximum_characters": 2500},
      "score_cap_on_failure": 0.55
    },
    {
      "id": "R010",
      "description": "两份报告明确声明问卷与客服快照不能逐客户关联，不宣称无法从输入推导的相关性、因果、行业基准、预算或收入影响。",
      "weight": 5,
      "type": "hurdle",
      "dimension": "factuality",
      "method": "deterministic",
      "method_params": {"forbidden_upstream_hallucinations": [245, 847, "r=0.68", "$150,000", "$1.2-1.5 million"]},
      "score_cap_on_failure": 0.6
    },
    {
      "id": "R011",
      "description": "两份 Excel 具备表头样式、冻结窗格、筛选或表格、合理列宽与数字格式；两份 Word 有标题和多级结构。",
      "weight": 4,
      "type": "positive",
      "dimension": "professional_standard",
      "method": "deterministic",
      "method_params": {"editable": true, "styled_headers": true, "heading_levels": true}
    },
    {
      "id": "R012",
      "description": "四个交付物均可由 LibreOffice 实际打开和渲染，核心文本与数字可见。",
      "weight": 3,
      "type": "positive",
      "dimension": "professional_standard",
      "method": "deterministic",
      "method_params": {"renderer": "libreoffice", "deliverables": 4}
    },
    {
      "id": "R013",
      "description": "任一核心指标、维度、分群或样本量与输入重算真值冲突，扣 14 分。",
      "weight": -14,
      "type": "penalty",
      "dimension": "data_accuracy",
      "method": "deterministic",
      "method_params": {"trigger": "any_source_derived_metric_mismatch"}
    },
    {
      "id": "R014",
      "description": "报告出现上游无来源的 245/847 样本量、r=0.68、行业基准、预算或收入影响，扣 12 分。",
      "weight": -12,
      "type": "penalty",
      "dimension": "factuality",
      "method": "deterministic",
      "method_params": {"trigger": "unsupported_claim"}
    },
    {
      "id": "R015",
      "description": "任一指定文件缺失、损坏、截图化或四份交付物核心数字不一致，扣 12 分。",
      "weight": -12,
      "type": "penalty",
      "dimension": "file_integrity",
      "method": "deterministic",
      "method_params": {"trigger": "missing_corrupt_flattened_or_cross_artifact_conflict"}
    }
  ]
}
