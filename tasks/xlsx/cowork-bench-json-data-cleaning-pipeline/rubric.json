  "criteria": [
    {
      "id": "R001",
      "description": "清洗脚本、三份结果 JSON、两份 Excel 和进度记录七个指定交付物均存在且可打开。",
      "weight": 6,
      "type": "hurdle",
      "dimension": "file_integrity",
      "method": "deterministic",
      "method_params": {"required_files": 7},
      "score_cap_on_failure": 0
