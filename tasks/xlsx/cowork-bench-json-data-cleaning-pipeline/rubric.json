      "weight": 7,
      "type": "hurdle",
      "dimension": "data_accuracy",
      "method": "deterministic",
      "method_params": {"records": 18, "dedupe_key": "order_id", "keep": "first"},
      "score_cap_on_failure": 0.45
    },
    {
      "id": "R005",
      "description": "cleaned_inventory.json 按 product_id 保留首条，恰有 5 条，商品名规范，并保留来源中的俄文 warehouse。",
      "weight": 7,
      "type": "hurdle",
      "dimension": "data_accuracy",
      "method": "deterministic",
      "method_params": {"records": 5, "dedupe_key": "product_id", "keep": "first", "preserve_warehouse": true},
      "score_cap_on_failure": 0.45
    },
    {
      "id": "R006",
      "description": "pipeline_results.json 的九项汇总、五个销售聚合、五个库存状态和五行 Combined View 全部正确。",
      "weight": 7,
      "type": "hurdle",
      "dimension": "data_accuracy",
      "method": "deterministic",
      "method_params": {"truth_source": "two_raw_json_inputs"},
      "score_cap_on_failure": 0.45
    },
    {
      "id": "R007",
      "description": "Data_Pipeline_Report.xlsx 恰有三张指定工作表，表头、五行数据、销量、收入、均价、库存和 Combined View 均与重算真值一致。",
      "weight": 8,
      "type": "hurdle",
      "dimension": "data_accuracy",
      "method": "deterministic",
      "method_params": {"sheets": 3, "rows_per_sheet": 5},
      "score_cap_on_failure": 0.45
    },
    {
      "id": "R008",
      "description": "Inventory Status 的五个 Status 单元格均为引用本行库存与补货点的原生 IF 公式，LibreOffice 重算结果正确。",
      "weight": 6,
      "type": "hurdle",
      "dimension": "data_accuracy",
      "method": "deterministic",
      "method_params": {"formula_cells": ["D2", "D3", "D4", "D5", "D6"]},
      "score_cap_on_failure": 0.5
    },
    {
      "id": "R009",
      "description": "Pipeline_Dashboard.xlsx 只有指定工作表，表头和五行数据与 Report 的 Combined View 完全一致。",
      "weight": 6,
      "type": "hurdle",
      "dimension": "data_accuracy",
      "method": "deterministic",
      "method_params": {"sheet": "Pipeline Dashboard", "rows": 5},
      "score_cap_on_failure": 0.55
    },
    {
      "id": "R010",
      "description": "progress_note.json 沿用 entities/relations 结构，准确记录读取、去重、规范化、报告和离线 Dashboard 以及 18/5 的清洗数量。",
      "weight": 5,
      "type": "hurdle",
      "dimension": "content_quality",
      "method": "deterministic",
      "method_params": {"entity": "Data_Pipeline"},
