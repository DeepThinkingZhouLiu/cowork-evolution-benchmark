{
  "task_id": "cowork-evo/cowork-bench-sf-regional-sales-forecast",
  "rubric_version": "cowork-bench-sf-regional-sales-static-v0.1",
  "pass_threshold": 0.75,
  "criteria": [
    {
      "id": "R001",
      "description": "指定 Excel 和 Word 均可打开、可编辑，Excel 包含 Historical、Forecast、Summary 三张表。",
      "weight": 4,
      "type": "hurdle",
      "dimension": "file_integrity",
      "method": "deterministic",
      "method_params": {
        "required_files": [
          "Sales_Forecast.xlsx",
          "Forecast_Report.docx"
        ]
      },
      "score_cap_on_failure": 0
    },
    {
      "id": "R002",
      "description": "Historical 完整保留 15 条来源聚合，地区、月份、订单数和收入全部正确。",
      "weight": 6,
      "type": "hurdle",
      "dimension": "factuality",
      "method": "deterministic",
      "method_params": {
        "source": "historical_sales.json",
        "rows": 15
      },
      "score_cap_on_failure": 0.74
    },
    {
      "id": "R003",
      "description": "五个地区的 Trailing_3M_Avg 均为对应三个月收入的正确平均值。",
      "weight": 5,
      "type": "hurdle",
      "dimension": "data_accuracy",
      "method": "deterministic",
      "method_params": {
        "regions": 5,
        "months": 3
      },
      "score_cap_on_failure": 0.74
    },
    {
      "id": "R004",
      "description": "五个俄文地区与 GDP 增长率正确联结，Economic_Adjustment 严格等于 1+GDP/100。",
      "weight": 5,
      "type": "hurdle",
      "dimension": "factuality",
      "method": "deterministic",
      "method_params": {
        "source": "economic_indicators.json"
      },
      "score_cap_on_failure": 0.74
    },
    {
      "id": "R005",
      "description": "Adjusted_Monthly_Forecast 和 Next_Quarter_Forecast 在五个地区上均按方法论与规定精度计算正确。",
      "weight": 6,
      "type": "hurdle",
      "dimension": "data_accuracy",
      "method": "deterministic",
      "method_params": {
        "quarter_multiplier": 3
      },
      "score_cap_on_failure": 0.74
    },
    {
      "id": "R006",
      "description": "Summary 的十项指标全部存在，总额、QoQ、最高/最低地区与 GDP 领先地区均正确。",
      "weight": 6,
      "type": "hurdle",
      "dimension": "data_accuracy",
      "method": "deterministic",
      "method_params": {
        "metrics": 10
      },
      "score_cap_on_failure": 0.74
    },
    {
      "id": "R007",
      "description": "Word 报告含俄文的简要摘要、方法论、区域分析、关键假设和建议五个章节。",
      "weight": 4,
      "type": "positive",
      "dimension": "structure",
      "method": "deterministic",
      "method_params": {
        "sections": 5,
        "language": "ru"
      }
    },
    {
      "id": "R008",
      "description": "Word 报告正确引用 Q4 实际、Q1 总预测、五地区预测与 GDP 背景，并给出与数据一致的建议。",
      "weight": 5,
      "type": "hurdle",
      "dimension": "factuality",
      "method": "deterministic",
      "method_params": {
        "region_numbers": 5,
        "totals": 2
      },
      "score_cap_on_failure": 0.74
    },
    {
      "id": "R009",
      "description": "Excel 和 Word 均可由 LibreOffice 真实渲染，关键表头、章节和预测数字可从 PDF 中读取。",
      "weight": 3,
      "type": "positive",
      "dimension": "professional_standard",
      "method": "deterministic",
      "method_params": {
        "renderer": "libreoffice",
        "outputs": 2
      }
    },
    {
      "id": "R010",
      "description": "若任一历史记录、区域联结或核心预测计算错误，则扣 10 分。",
      "weight": -10,
      "type": "penalty",
      "dimension": "data_accuracy",
      "method": "deterministic",
      "method_params": {
        "trigger_any_model_error": true
      }
    },
    {
      "id": "R011",
      "description": "若 Word 报告缺章节、缺关键数字或与 Excel 结论冲突，则扣 10 分。",
      "weight": -10,
      "type": "penalty",
      "dimension": "factuality",
      "method": "deterministic",
      "method_params": {
        "report_must_match_workbook": true
      }
    },
    {
      "id": "R012",
