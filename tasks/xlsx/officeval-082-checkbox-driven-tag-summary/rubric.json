{
  "task_id": "cowork-evo/officeval-082-checkbox-driven-tag-summary",
  "rubric_version": "omegause-officeval-082-adaptation-v0.1",
  "pass_threshold": 0.75,
  "criteria": [
    {
      "id": "R001",
      "description": "交付文件为指定名称的可打开 XLSX，且只包含原始“标签维度表”工作表。",
      "weight": 2,
      "type": "hurdle",
      "dimension": "file_integrity",
      "method": "deterministic",
      "method_params": {
        "output_filename": "1111_勾选自动汇总版.xlsx",
        "worksheets": [
          "标签维度表"
        ]
      },
      "score_cap_on_failure": 0
    },
    {
      "id": "R002",
      "description": "A:C 保留五个真实分类和 B/C 两列全部 126 个真实标签；标签文字、分类、标题、表头、边框和主体样式不被错改，仍为可编辑单元格。",
      "weight": 5,
      "type": "positive",
      "dimension": "content_quality",
      "method": "deterministic",
      "method_params": {
        "compare_with_input": true,
        "tag_count": 126,
        "category_count": 5
      }
    },
    {
      "id": "R003",
      "description": "B/C 每个非空标签都有且只有一个与本标签一一对应的可点击双态控件，能够在 `□ 标签` 和 `☑ 标签` 之间切换，不能漏项或用图片冒充。",
      "weight": 6,
      "type": "positive",
      "dimension": "instruction_following",
      "method": "deterministic",
      "method_params": {
        "cell_level_controls": 126,
        "states": [
          "unchecked",
          "checked"
        ],
        "upstream_verifier": true
      }
    },
    {
      "id": "R004",
      "description": "右侧 I:J 使用可编辑公式或等效逻辑同时关联 B、C 两列的选中状态，可保留多个已选项；取消一项时只移除该项，不出现 TRUE、FALSE、0、1 或公式错误。",
      "weight": 6,
      "type": "positive",
      "dimension": "data_accuracy",
      "method": "deterministic",
      "method_params": {
        "source_columns": [
          "B",
          "C"
        ],
        "output_columns": [
          "I",
          "J"
        ],
        "multi_select": true
      }
    },
    {
      "id": "R005",
      "description": "右侧 I4:J4 保留“维度分类（选定）”标题；A 为 8–12 字符宽，B/C/I/J 为 24–26 字符宽，输出行高 20–24 磅，字体、颜色、对齐、边框和换行清晰可读。",
      "weight": 4,
      "type": "positive",
      "dimension": "presentation",
      "method": "deterministic",
      "method_params": {
        "title": "维度分类（选定）",
        "row_height_range": [
          20,
          24
        ],
        "upstream_verifier": true
      }
    },
    {
      "id": "R006",
      "description": "工作表不受保护，控件、标签、关联公式和右侧输出逻辑都可继续修改；工作簿启用打开时自动完整重算，且不含替代左表的嵌入图片。",
      "weight": 3,
      "type": "positive",
      "dimension": "structure",
      "method": "deterministic",
      "method_params": {
        "sheet_protection": false,
        "calc_mode": "auto",
        "embedded_images": 0
      }
    },
    {
      "id": "R007",
      "description": "Judge 分别执行“B5+B31+C40+C68”和“仅 C6”两组真实勾选，LibreOffice 重算后 I:J 必须精确显示对应分类与标签，不能缺项、多项或残留上一次结果。",
      "weight": 8,
      "type": "positive",
      "dimension": "instruction_following",
      "method": "deterministic",
      "method_params": {
        "engine": "LibreOffice Calc",
        "scenarios": 2,
        "exact_set_match": true
      }
    },
    {
      "id": "R008",
      "description": "交付物可经 LibreOffice 正常渲染，PDF 中能够读取完整左侧五类标签、右侧标题和汇总区，页数合理且没有关键内容缺失。",
      "weight": 3,
      "type": "positive",
      "dimension": "professional_standard",
      "method": "deterministic",
      "method_params": {
        "renderer": "libreoffice",
        "page_range": [
          1,
          8
        ]
      }
    },
    {
      "id": "R009",
      "description": "若任一真实分类或标签缺失、错改，或任一标签没有一一对应的双态勾选控件，则扣 10 分。",
      "weight": -10,
      "type": "penalty",
      "dimension": "content_quality",
      "method": "deterministic",
      "method_params": {
        "trigger_on_any_missing_label_or_control": true
      }
    },
    {
      "id": "R010",
      "description": "若右侧结果是静态写死、只关联 B/C 其中一列，或任一 LibreOffice 行为回放失败，则扣 10 分。",
      "weight": -10,
      "type": "penalty",
      "dimension": "data_accuracy",
      "method": "deterministic",
      "method_params": {
        "trigger_on_static_partial_or_failed_replay": true
      }
    },
    {
      "id": "R011",
      "description": "若 A:C 被图片或截图替代、交付物含嵌入图片，或工作表受保护而无法继续编辑，则扣 8 分。",
      "weight": -8,
      "type": "penalty",
      "dimension": "structure",
      "method": "deterministic",
      "method_params": {
        "forbid_screenshot_substitution": true
      }
    },
    {
      "id": "R012",
      "description": "若关键列宽、标题、输出字体/行高、显示值或 LibreOffice 实际渲染不符合要求，则扣 6 分。",
      "weight": -6,
      "type": "penalty",
      "dimension": "presentation",
      "method": "deterministic",
      "method_params": {
        "layout_and_render_required": true
      }
    }
  ]
}
