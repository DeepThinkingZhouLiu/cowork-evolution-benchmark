{
  "task_id": "cowork-evo/officeval-086-editable-composite-pie-chart",
  "rubric_version": "omegause-officeval-086-adaptation-v0.1",
  "pass_threshold": 0.75,
  "criteria": [
    {
      "id": "R001",
      "description": "交付物为指定名称且可正常打开的 XLSX。",
      "weight": 2,
      "type": "hurdle",
      "dimension": "file_integrity",
      "method": "deterministic",
      "method_params": {"output_filename": "数据1_复合饼图_Sheet2.xlsx"},
      "score_cap_on_failure": 0
    },
    {
      "id": "R002",
      "description": "仅保留 Sheet1 和 Sheet2；Sheet1 的两层比例数值完整，并按 Query 正确映射为六个业务名称。",
      "weight": 5,
      "type": "hurdle",
      "dimension": "data_accuracy",
      "method": "deterministic",
      "method_params": {"sheets": ["Sheet1", "Sheet2"], "main_values": [0.55, 0.34, 0.11], "detail_values": [0.15, 0.65, 0.20]},
      "score_cap_on_failure": 0
    },
    {
      "id": "R003",
      "description": "Sheet2 含两个与 Sheet1 数据引用相连的原生可编辑饼图，且没有用图片替代图表。",
      "weight": 4,
      "type": "hurdle",
      "dimension": "file_integrity",
      "method": "deterministic",
      "method_params": {"native_pie_charts": 2, "embedded_images": 0, "source_sheet": "Sheet1"},
      "score_cap_on_failure": 0
    },
    {
      "id": "R004",
      "description": "左侧主饼图和右侧拆分饼图的核心布局、分类、比例和虚线连接符合原始要求。",
      "weight": 5,
      "type": "positive",
      "dimension": "presentation",
      "method": "deterministic",
      "method_params": {"upstream_rule": "+5#核心布局、数据比例与虚线连接"}
    },
    {
      "id": "R005",
      "description": "左侧主饼图显示人员薪酬 55%、物料 34%、其他 11%，并同时显示分类名和百分比。",
      "weight": 1,
      "type": "positive",
      "dimension": "data_accuracy",
      "method": "deterministic",
      "method_params": {"upstream_rule": "+1#左侧主饼图标签"}
    },
    {
      "id": "R006",
      "description": "右侧拆分饼图显示交通 15%、住宿 65%、餐饮 20%，并同时显示分类名和百分比。",
      "weight": 1,
      "type": "positive",
      "dimension": "data_accuracy",
      "method": "deterministic",
      "method_params": {"upstream_rule": "+1#右侧拆分饼图标签"}
    },
    {
      "id": "R007",
      "description": "六个扇区使用互相可区分的浅色或中饱和度配色，且有 0.75–1.5 磅白色或浅灰分隔线。",
      "weight": 1,
      "type": "positive",
      "dimension": "presentation",
      "method": "deterministic",
      "method_params": {"upstream_rule": "+1#扇区配色与分隔线"}
    },
    {
      "id": "R008",
      "description": "两个饼图之间有上下两条灰色或浅灰色虚线，线宽为 0.75–1.25 磅。",
      "weight": 1,
      "type": "positive",
      "dimension": "presentation",
      "method": "deterministic",
      "method_params": {"upstream_rule": "+1#两条灰色虚线"}
    },
    {
      "id": "R009",
      "description": "主饼图直径是拆分饼图的 1.3–1.8 倍，水平间距约 3–7 厘米，两者不重叠。",
      "weight": 1,
      "type": "positive",
      "dimension": "presentation",
      "method": "deterministic",
      "method_params": {"diameter_ratio": [1.3, 1.8], "gap_cm": [3, 7]}
    },
    {
      "id": "R010",
      "description": "图例不遮挡数据标签；Sheet2 页面标题表达“费用构成复合饼图”，不含默认“图表标题”。",
      "weight": 2,
      "type": "positive",
      "dimension": "professional_standard",
      "method": "deterministic",
      "method_params": {"upstream_rules": ["+1#图例", "+1#图表标题区域"], "worksheet_title": "费用构成复合饼图"}
    },
    {
      "id": "R011",
      "description": "工作簿可由 LibreOffice 实际渲染为 2 页 PDF，第二页包含标题和六个分类文本。",
      "weight": 3,
      "type": "positive",
      "dimension": "professional_standard",
      "method": "deterministic",
      "method_params": {"renderer": "libreoffice", "pages": 2}
    },
    {
      "id": "R012",
      "description": "若以截图替代可编辑图表，或缺失任一原生饼图，则扣 8 分。",
      "weight": -8,
      "type": "penalty",
      "dimension": "file_integrity",
      "method": "deterministic",
      "method_params": {"embedded_image_trigger": 1, "native_pie_charts_below": 2}
    },
    {
      "id": "R013",
      "description": "若修改任一原始比例数值或丢失 Sheet1 数据，则扣 6 分。",
      "weight": -6,
      "type": "penalty",
      "dimension": "data_accuracy",
      "method": "deterministic",
      "method_params": {"compare_with_source": true}
    },
    {
      "id": "R014",
      "description": "若新增无关工作表或保留默认“图表标题”，则扣 2 分。",
      "weight": -2,
      "type": "penalty",
      "dimension": "instruction_following",
      "method": "deterministic",
      "method_params": {"allowed_sheets": ["Sheet1", "Sheet2"], "forbidden_text": "图表标题"}
    }
  ]
}
