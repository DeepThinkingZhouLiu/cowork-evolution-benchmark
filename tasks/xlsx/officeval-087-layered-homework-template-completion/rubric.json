{
  "task_id": "cowork-evo/officeval-087-layered-homework-template-completion",
  "rubric_version": "omegause-officeval-087-adaptation-v0.1",
  "pass_threshold": 0.75,
  "criteria": [
    {
      "id": "R001",
      "description": "交付文件为指定名称的可打开 XLSX，工作表名称、数量和顺序严格保持为 Sheet1、Sheet2、Sheet3。",
      "weight": 2,
      "type": "hurdle",
      "dimension": "file_integrity",
      "method": "deterministic",
      "method_params": {"output_filename": "分层作业设计_填充完成.xlsx", "worksheets": ["Sheet1", "Sheet2", "Sheet3"]},
      "score_cap_on_failure": 0
    },
    {
      "id": "R002",
      "description": "识字源表的标题、作业简介、基础层 4 题、提高层 3 题、拓展层 2 项和评价内容完整迁入对应模板区域；基础层有 6 组拼音填空，提高层第 3 题保留 15 个填空槽。",
      "weight": 8,
      "type": "positive",
      "dimension": "content_quality",
      "method": "deterministic",
      "method_params": {"expected_content": "tests/expected-content.json", "base_slots": 6, "improve_slots": 15}
    },
    {
      "id": "R003",
      "description": "Sheet1 恰好保留 A1:F1、B3:F3、C4:F4、C5:F5、C6:F6、A4:A6、A7:A9、B7:F9 八个合并区域；B2、D2、F2 保持空白，Sheet2 和 Sheet3 保持原有空白状态。",
      "weight": 4,
      "type": "positive",
      "dimension": "structure",
      "method": "deterministic",
      "method_params": {"merged_regions": 8, "blank_sheets": ["Sheet2", "Sheet3"]}
    },
    {
      "id": "R004",
      "description": "A–F 列宽分别为 12.75、14.63、13.13、17.38、12.25、15.5；标题、简介、三层标题、反馈标题的宋体字号、加粗、对齐、行高和自动换行满足上游细则。",
      "weight": 4,
      "type": "positive",
      "dimension": "presentation",
      "method": "deterministic",
      "method_params": {"reuse_upstream_format_checks": true, "base_row_height_pt": [250, 350], "improve_row_height_pt": [350, 450]}
    },
    {
      "id": "R005",
      "description": "输出只使用从识字源表逐项选出的 8 个真实媒体对象，媒体 SHA256 与源文件一致；基础层保留 6 个田字格图片，提高层保留两张山水图，其中第 3 题山水图为 5.5–5.7 × 2.7–2.9 厘米且不遮挡文字。",
      "weight": 4,
      "type": "positive",
      "dimension": "factuality",
      "method": "deterministic",
      "method_params": {"compare_source_media_sha256": true, "media_count": 8}
    },
    {
      "id": "R006",
      "description": "模板 A1:F9 的表格边框和填充逐格保持，班级、任教教师、时间、三层标题及作业情况反馈等固定标签没有被删除或无关改写。",
      "weight": 3,
      "type": "positive",
      "dimension": "instruction_following",
      "method": "deterministic",
      "method_params": {"compare_template_borders_and_fills": true}
    },
    {
      "id": "R007",
      "description": "XLSX 能经 LibreOffice 实际渲染为 2–4 个纵向打印页，标题、三层作业和评价区的关键文字均可读取，没有横向分页把同一模板拆开。",
      "weight": 3,
      "type": "positive",
      "dimension": "professional_standard",
      "method": "deterministic",
      "method_params": {"renderer": "libreoffice", "page_range": [2, 4], "fit_to_width": 1}
    },
    {
      "id": "R008",
      "description": "基础层、提高层、拓展层和评价区仍是可编辑 Excel 单元格文本，Sheet1 未受保护，不能用整表截图或不可编辑对象替代。",
      "weight": 2,
      "type": "positive",
      "dimension": "file_integrity",
      "method": "deterministic",
      "method_params": {"editable_cells": ["C4", "C5", "C6", "B7"], "sheet_protected": false}
    },
    {
      "id": "R009",
      "description": "若两处及以上真实源内容缺失、改写、错层，或填空槽数量不符，则扣 8 分。",
      "weight": -8,
      "type": "penalty",
      "dimension": "content_quality",
      "method": "deterministic",
      "method_params": {"trigger_content_error_groups": 2}
    },
    {
      "id": "R010",
      "description": "若模板合并区域、基本信息空白区、两个空白工作表、表格边框、填充或固定标签被破坏，则扣 8 分。",
      "weight": -8,
      "type": "penalty",
      "dimension": "instruction_following",
      "method": "deterministic",
      "method_params": {"protect_template_structure": true}
    },
    {
      "id": "R011",
      "description": "若关键列宽或行高错误、真实图片缺失或遮挡文字，或 LibreOffice 实际渲染失败，则扣 5 分。",
      "weight": -5,
      "type": "penalty",
      "dimension": "presentation",
      "method": "deterministic",
      "method_params": {"critical_layout_or_render_defect": true}
    }
  ]
}
